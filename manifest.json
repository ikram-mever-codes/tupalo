{
  "manifest_version": 3,
  "name": "Tupalo Germany Scraper",
  "version": "1.0",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads",
    "activeTab"
  ],
  "host_permissions": ["https://www.tupalo.de/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.tupalo.de/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
